{
  "name": "dj-copilot-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Copiloto local de preparación musical para Mixxx",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node scripts/start.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "check": "npm test && npm run build",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.4.5",
    "playwright": "^1.56.0",
    "prettier": "^3.9.9",
    "vite": "^7.3.0"
  }
}
